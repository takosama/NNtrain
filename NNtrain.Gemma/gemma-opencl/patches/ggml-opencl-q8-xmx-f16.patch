+
+// Opt-in Intel XMX experiment.  A GGUF Q8_0 block has 32 signed bytes and a
+// half-precision scale.  Keep that compact representation resident in VRAM,
+// dequantize an 8-row x 16-K panel into subgroup registers, and feed the
+// hardware matrix instruction directly.  F32 activations are rounded to F16
+// in registers; the result is accumulated in F32.
+#if defined(cl_intel_subgroup_matrix_multiply_accumulate) && defined(cl_intel_required_subgroup_size)
+#pragma OPENCL EXTENSION cl_intel_subgroup_matrix_multiply_accumulate : enable
+#pragma OPENCL EXTENSION cl_intel_required_subgroup_size : enable
+
+inline short q8_xmx_weight(global const char * qs, global const half * ds,
+                           int batch_a, int row, int k, int ne00, int ne01) {
+    if (row >= ne01) {
+        return (short) 0;
+    }
+    const int qidx = batch_a * ne00 * ne01 + row * ne00 + k;
+    const float v = (float) qs[qidx] * (float) ds[qidx / 32];
+    return as_short(convert_half_rte(v));
+}
+
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_mul_mm_q8_0_f32_xmx_f16(
+    global const char * src0_q,
+    global const half * src0_d,
+    global const float * src1,
+    ulong offset1,
+    global float * dst,
+    ulong offsetd,
+    int ne00,
+    int ne01,
+    int ne02,
+    int ne11,
+    int ne12,
+    int stride_a,
+    int stride_b,
+    int stride_d,
+    int batch_stride_a,
+    int batch_stride_b,
+    int batch_stride_d,
+    int r2,
+    int r3) {
+    src1 = (global const float *) ((global const char *) src1 + offset1);
+    dst = (global float *) ((global char *) dst + offsetd);
+
+    const int lane = get_local_id(0);
+    const int row = get_group_id(0) * 8;
+    const int col = get_group_id(1) * 16 + lane;
+    const int batch = get_group_id(2);
+    const int i13 = batch / ne12;
+    const int i12 = batch % ne12;
+    const int batch_a = (i13 / r3) * ne02 + i12 / r2;
+    const global float * b = src1 + batch * batch_stride_b + col * stride_b;
+
+    float8 acc = (float8) (0.0f);
+    for (int k = 0; k < ne00; k += 16) {
+        int8 bp = (int8) (0);
+        if (col < ne11) {
+            bp = as_int8(convert_half16_rte(vload16(0, b + k)));
+        }
+
+        short8 ap = (short8) (
+            q8_xmx_weight(src0_q, src0_d, batch_a, row + 0, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row + 1, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row + 2, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row + 3, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row + 4, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row + 5, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row + 6, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row + 7, k + lane, ne00, ne01));
+
+        acc = intel_sub_group_f16_f16_matrix_mad_k16(ap, bp, acc);
+    }
+
+    if (col < ne11) {
+        const int out = batch * batch_stride_d + col * stride_d + row;
+        if (row + 0 < ne01) dst[out + 0] = acc.s0;
+        if (row + 1 < ne01) dst[out + 1] = acc.s1;
+        if (row + 2 < ne01) dst[out + 2] = acc.s2;
+        if (row + 3 < ne01) dst[out + 3] = acc.s3;
+        if (row + 4 < ne01) dst[out + 4] = acc.s4;
+        if (row + 5 < ne01) dst[out + 5] = acc.s5;
+        if (row + 6 < ne01) dst[out + 6] = acc.s6;
+        if (row + 7 < ne01) dst[out + 7] = acc.s7;
+    }
+}
+#endif
