diff --git a/ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat_rows.cl b/ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat_rows.cl
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-opencl/kernels/mul_mv_q8_0_f32_flat_rows.cl
@@ -0,0 +1,93 @@
+#pragma OPENCL EXTENSION cl_khr_fp16 : enable
+#pragma OPENCL EXTENSION cl_intel_subgroups : enable
+#pragma OPENCL EXTENSION cl_intel_required_subgroup_size : enable
+
+#ifndef Q8_ROW_TILE
+#define Q8_ROW_TILE 8
+#endif
+
+#if Q8_ROW_TILE != 2 && Q8_ROW_TILE != 8
+#error Q8_ROW_TILE must be 2 or 8
+#endif
+
+// Candidate for Intel Arc: vary the number of output rows held by one SIMD16
+// subgroup while leaving the on-device Q8_0 SoA layout unchanged.
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_mul_mv_q8_0_f32_flat_rows(
+    global char * src0_q,
+    global half * src0_d,
+    global char * src1,
+    ulong         offset1,
+    global char * dst,
+    ulong         offsetd,
+    int           ne00,
+    int           ne01,
+    ulong         nb01,
+    ulong         nb02,
+    ulong         nb03,
+    int           ne12,
+    ulong         nb11,
+    ulong         nb12,
+    ulong         nb13,
+    int           ne0,
+    int           ne1,
+    int           r2,
+    int           r3
+) {
+    src1 += offset1;
+    dst  += offsetd;
+
+    const int subgroup = get_sub_group_id();
+    const int lane = get_sub_group_local_id();
+    const int first_row = (get_group_id(0)*2 + subgroup)*Q8_ROW_TILE;
+    const int r1 = get_group_id(1);
+    const int im = get_group_id(2);
+    const uint i12 = im%ne12;
+    const uint i13 = im/ne12;
+    const int nb = ne00/32;
+    const int ix = lane/4;
+    const int il = lane%4;
+
+    global float * y = (global float *)(src1 + (ulong)r1*nb11 +
+                                        (ulong)i12*nb12 + (ulong)i13*nb13);
+    global float * yb = y + ix*32 + il*8;
+
+    // Quantized rows are contiguous in blocks of 34 bytes on the source side.
+    const ulong block_base = ((ulong)first_row*nb01 +
+                              (ulong)(i12/r2)*nb02 +
+                              (ulong)(i13/r3)*nb03)/34;
+    const ulong block_row_stride = nb01/34;
+    global char * ax[Q8_ROW_TILE];
+    global half * ad[Q8_ROW_TILE];
+    float acc[Q8_ROW_TILE];
+
+#pragma unroll
+    for (int row = 0; row < Q8_ROW_TILE; ++row) {
+        const ulong block_offset = block_base + (ulong)row*block_row_stride;
+        ax[row] = src0_q + block_offset*32;
+        ad[row] = src0_d + block_offset;
+        acc[row] = 0.0f;
+    }
+
+    for (int ib = ix; ib < nb; ib += 4) {
+        const float8 yl = vload8(0, yb);
+#pragma unroll
+        for (int row = 0; row < Q8_ROW_TILE; ++row) {
+            const char8 q8 = vload8(0, ax[row] + (ulong)ib*32 + il*8);
+            const float8 q = convert_float8(q8);
+            const float dot8 = dot(q.lo, yl.lo) + dot(q.hi, yl.hi);
+            acc[row] = mad(dot8, (float)ad[row][ib], acc[row]);
+        }
+        yb += 128;
+    }
+
+    global float * dst_f32 = (global float *)dst +
+                             (ulong)im*ne0*ne1 + (ulong)r1*ne0;
+#pragma unroll
+    for (int row = 0; row < Q8_ROW_TILE; ++row) {
+        const float total = sub_group_reduce_add(acc[row]);
+        if (lane == 0 && first_row + row < ne01) {
+            dst_f32[first_row + row] = total;
+        }
+    }
+}
