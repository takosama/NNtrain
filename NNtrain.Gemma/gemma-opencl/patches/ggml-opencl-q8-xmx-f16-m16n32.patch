+
+// One 16-lane subgroup covers two 8-row A panels and two 16-column B panels.
+// Reuse each panel across four K16 matrix operations and retain F32 accumulators.
+__attribute__((intel_reqd_sub_group_size(16)))
+kernel void kernel_mul_mm_q8_0_f32_xmx_f16_m16n32(
+    global const char * src0_q,
+    global const half * src0_d,
+    global const float * src1,
+    ulong offset1,
+    global float * dst,
+    ulong offsetd,
+    int ne00,
+    int ne01,
+    int ne02,
+    int ne11,
+    int ne12,
+    int stride_a,
+    int stride_b,
+    int stride_d,
+    int batch_stride_a,
+    int batch_stride_b,
+    int batch_stride_d,
+    int r2,
+    int r3) {
+    src1 = (global const float *) ((global const char *) src1 + offset1);
+    dst = (global float *) ((global char *) dst + offsetd);
+
+    const int lane = get_local_id(0);
+    const int row0 = get_group_id(0) * 16;
+    const int row1 = row0 + 8;
+    const int col0 = get_group_id(1) * 32 + lane;
+    const int col1 = col0 + 16;
+    const int batch = get_group_id(2);
+    const int i13 = batch / ne12;
+    const int i12 = batch % ne12;
+    const int batch_a = (i13 / r3) * ne02 + i12 / r2;
+
+    float8 acc00 = (float8) (0.0f);
+    float8 acc01 = (float8) (0.0f);
+    float8 acc10 = (float8) (0.0f);
+    float8 acc11 = (float8) (0.0f);
+    for (int k = 0; k < ne00; k += 16) {
+        int8 bp0 = (int8) (0);
+        int8 bp1 = (int8) (0);
+        if (col0 < ne11) {
+            const global float * b0 = src1 + batch * batch_stride_b + col0 * stride_b + k;
+            bp0 = as_int8(convert_half16_rte(vload16(0, b0)));
+        }
+        if (col1 < ne11) {
+            const global float * b1 = src1 + batch * batch_stride_b + col1 * stride_b + k;
+            bp1 = as_int8(convert_half16_rte(vload16(0, b1)));
+        }
+
+        const short8 ap0 = (short8) (
+            q8_xmx_weight(src0_q, src0_d, batch_a, row0 + 0, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row0 + 1, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row0 + 2, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row0 + 3, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row0 + 4, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row0 + 5, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row0 + 6, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row0 + 7, k + lane, ne00, ne01));
+        const short8 ap1 = (short8) (
+            q8_xmx_weight(src0_q, src0_d, batch_a, row1 + 0, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row1 + 1, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row1 + 2, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row1 + 3, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row1 + 4, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row1 + 5, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row1 + 6, k + lane, ne00, ne01),
+            q8_xmx_weight(src0_q, src0_d, batch_a, row1 + 7, k + lane, ne00, ne01));
+
+        acc00 = intel_sub_group_f16_f16_matrix_mad_k16(ap0, bp0, acc00);
+        acc01 = intel_sub_group_f16_f16_matrix_mad_k16(ap0, bp1, acc01);
+        acc10 = intel_sub_group_f16_f16_matrix_mad_k16(ap1, bp0, acc10);
+        acc11 = intel_sub_group_f16_f16_matrix_mad_k16(ap1, bp1, acc11);
+    }
+
+    if (col0 < ne11) {
+        const int out0 = batch * batch_stride_d + col0 * stride_d;
+        if (row0 + 0 < ne01) dst[out0 + row0 + 0] = acc00.s0;
+        if (row0 + 1 < ne01) dst[out0 + row0 + 1] = acc00.s1;
+        if (row0 + 2 < ne01) dst[out0 + row0 + 2] = acc00.s2;
+        if (row0 + 3 < ne01) dst[out0 + row0 + 3] = acc00.s3;
+        if (row0 + 4 < ne01) dst[out0 + row0 + 4] = acc00.s4;
+        if (row0 + 5 < ne01) dst[out0 + row0 + 5] = acc00.s5;
+        if (row0 + 6 < ne01) dst[out0 + row0 + 6] = acc00.s6;
+        if (row0 + 7 < ne01) dst[out0 + row0 + 7] = acc00.s7;
+        if (row1 + 0 < ne01) dst[out0 + row1 + 0] = acc10.s0;
+        if (row1 + 1 < ne01) dst[out0 + row1 + 1] = acc10.s1;
+        if (row1 + 2 < ne01) dst[out0 + row1 + 2] = acc10.s2;
+        if (row1 + 3 < ne01) dst[out0 + row1 + 3] = acc10.s3;
+        if (row1 + 4 < ne01) dst[out0 + row1 + 4] = acc10.s4;
+        if (row1 + 5 < ne01) dst[out0 + row1 + 5] = acc10.s5;
+        if (row1 + 6 < ne01) dst[out0 + row1 + 6] = acc10.s6;
+        if (row1 + 7 < ne01) dst[out0 + row1 + 7] = acc10.s7;
+    }
+    if (col1 < ne11) {
+        const int out1 = batch * batch_stride_d + col1 * stride_d;
+        if (row0 + 0 < ne01) dst[out1 + row0 + 0] = acc01.s0;
+        if (row0 + 1 < ne01) dst[out1 + row0 + 1] = acc01.s1;
+        if (row0 + 2 < ne01) dst[out1 + row0 + 2] = acc01.s2;
+        if (row0 + 3 < ne01) dst[out1 + row0 + 3] = acc01.s3;
+        if (row0 + 4 < ne01) dst[out1 + row0 + 4] = acc01.s4;
+        if (row0 + 5 < ne01) dst[out1 + row0 + 5] = acc01.s5;
+        if (row0 + 6 < ne01) dst[out1 + row0 + 6] = acc01.s6;
+        if (row0 + 7 < ne01) dst[out1 + row0 + 7] = acc01.s7;
+        if (row1 + 0 < ne01) dst[out1 + row1 + 0] = acc11.s0;
+        if (row1 + 1 < ne01) dst[out1 + row1 + 1] = acc11.s1;
+        if (row1 + 2 < ne01) dst[out1 + row1 + 2] = acc11.s2;
+        if (row1 + 3 < ne01) dst[out1 + row1 + 3] = acc11.s3;
+        if (row1 + 4 < ne01) dst[out1 + row1 + 4] = acc11.s4;
+        if (row1 + 5 < ne01) dst[out1 + row1 + 5] = acc11.s5;
+        if (row1 + 6 < ne01) dst[out1 + row1 + 6] = acc11.s6;
+        if (row1 + 7 < ne01) dst[out1 + row1 + 7] = acc11.s7;
+    }
+}
 #endif
