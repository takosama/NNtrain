+// A cl_program built with device_list == NULL has binaries for every device
+// in its context.  Both Arc devices share one context, so the second backend
+// can create its own kernels from the program built for the first backend.
+struct ggml_opencl_program_cache {
+    struct entry {
+        cl_context context;
+        std::string source;
+        std::string options;
+        cl_program program;
+    };
+
+    std::mutex mutex;
+    std::vector<entry> entries;
+    size_t hits = 0;
+    size_t misses = 0;
+
+    ~ggml_opencl_program_cache() {
+        for (const auto & item : entries) {
+            clReleaseProgram(item.program);
+        }
+    }
+};
+
+static ggml_opencl_program_cache & get_ggml_opencl_program_cache() {
+    static ggml_opencl_program_cache cache;
+    return cache;
+}
+
+static void release_cached_programs_for_context(cl_context context) {
+    auto & cache = get_ggml_opencl_program_cache();
+    std::lock_guard<std::mutex> lock(cache.mutex);
+    const auto old_size = cache.entries.size();
+    const auto first_removed = std::remove_if(cache.entries.begin(), cache.entries.end(),
+        [context](const ggml_opencl_program_cache::entry & item) {
+            if (item.context != context) {
+                return false;
+            }
+            CL_CHECK(clReleaseProgram(item.program));
+            return true;
+        });
+    cache.entries.erase(first_removed, cache.entries.end());
+    GGML_LOG_INFO("ggml_opencl: program cache: released %zu entries after device initialization\n",
+                  old_size - cache.entries.size());
+}
