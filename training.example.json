{
  "schemaVersion": 2,
  "task": {
    "type": "wiki-language-model"
  },
  "data": {
    "dataPath": "data/wiki",
    "textColumn": "text",
    "tokenizerPath": "wiki-jp-bpe.json",
    "tokenizerTrainingDocuments": 500000,
    "tokenizerTrainingBytes": 2000000,
    "maxTrainingDocuments": 0,
    "maxTrainingTokens": 0,
    "maxDocumentTokens": 4096
  },
  "model": {
    "vocabularySize": 4000,
    "contextLength": 1024,
    "modelWidth": 384,
    "heads": 8,
    "hiddenSize": 1152,
    "layers": 16,
    "modelArchitecture": "forgetmemoryv3",
    "forgetMemoryKeyWidth": 16,
    "forgetMemoryValueWidth": 16,
    "forgetMemoryRetentionMinimum": 0.5,
    "forgetMemoryRetentionMaximum": 0.99,
    "dropout": 0.1,
    "initializationScale": 0.02
  },
  "training": {
    "validationFraction": 0.0,
    "epochs": 4,
    "batchSize": 1
  },
  "runtime": {
    "seed": 1234,
    "useSimd": true,
    "maxDegreeOfParallelism": 0
  },
  "reporting": {
    "logEveryBatches": 10,
    "showLossGraph": true,
    "graphUpdateSteps": 100,
    "datasetSampleEverySteps": 1000,
    "datasetSamplePoolSize": 32,
    "maxNewTokens": 80,
    "temperature": 0.8,
    "topK": 40
  },
  "optimization": {
    "optimizer": {
      "type": "adamw",
      "learningRate": 0.0003,
      "auxiliaryLearningRate": 0.0003,
      "nekoMuonNewtonSchulzInterval": 5,
      "weightDecay": 0.01,
      "adamWUseBFloat16FirstMoment": false,
      "adamWUseBFloat16SecondMoment": false
    },
    "scheduler": {
      "type": "warmupCosineProgress",
      "warmupPercent": 20
    }
  },
  "checkpoint": {
    "directory": "checkpoints",
    "fileName": "training.forgetmemoryv3-wiki-jp.model.json",
    "resume": false,
    "autoResume": true
  }
}
