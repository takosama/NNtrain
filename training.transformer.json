{
  "task": "gpt_rin_wiki_jp",
  "dataset": "fineweb",
  "dataPath": "data/fineweb",
  "textColumn": "text",
  "tokenizerPath": "fineweb-bpe.json",
  "checkpoint": {
    "directory": "checkpoints",
    "fileName": "training.transformer.tied.model.json",
    "resume": false,
    "autoResume": true,
    "intervalMinutes": 30
  },

  "vocabularySize": 11500,
  "tokenizerTrainingDocuments": 1000000,
  "tokenizerTrainingBytes": 200000000,

  "maxTrainingDocuments": 0,
  "maxTrainingTokens": 0,
  "maxDocumentTokens": 2048,
  "validationFraction": 0.0,
  "epochs": 1,
  "batchSize": 16,
  "gradientAccumulationSteps": 8,

  "contextLength": 2048,
  "modelWidth": 512,
  "heads":16,
  "hiddenSize": 1536,
  "layers": 32,
  "modelArchitecture": "transformer",
  "device": "arc",
  "deviceIndex": 0,
  "deviceIndices": [0, 1],
  "inferenceDeviceIndices": [0, 1],
  "arcInferenceMode": "auto",
  "adaptiveCudaSharding": true,
  "cudaShardEmaAlpha": 0.2,
  "cudaMinimumRelativeShardSize": 0.5,
  "cudaMaximumBatchAdjustmentPerStep": 1,
  "precisionMode": "mix8_16",
  "bfp8_block_size": 32,
  "tieWordEmbeddings": true,
  "forgetMemoryKeyWidth": 16,
  "forgetMemoryValueWidth": 16,
  "forgetMemoryRetentionMinimum": 0.5,
  "forgetMemoryRetentionMaximum": 0.99,
  "dropout": 0.1,
  "initializationScale": 0.02,

  "optimization": {
    "optimizer": {
      "type": "muon",
      "learningRate": 0.001,
      "auxiliaryLearningRate": 0.0003,
      "nekoMuonNewtonSchulzInterval": 1,
      "nekoMuonNewtonSchulzDepthMode": "fixed",
      "nekoMuonNewtonSchulzDepth": 5,
      "weightDecay": 0.01
    },
    "scheduler": {
      "type": "warmupCosineProgress",
      "warmupPercent": 0
    }
  },
  "seed": 1234,
  "logEveryBatches": 10,
  "showLossGraph": true,
  "graphUpdateSteps": 10,
  "datasetSampleEverySteps": 200,
  "datasetSamplePoolSize": 32,
  "useSimd": true,
  "maxDegreeOfParallelism": 0,

  "maxNewTokens": 200,
  "temperature": 0.9,
  "topK": 40
}
