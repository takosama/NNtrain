{
  "schemaVersion": 2,
  "task": {
    "type": "image-classification"
  },
  "data": {
    "trainingData": {
      "type": "cifar100",
      "dataPath": "data/cifar-100-binary/train.bin",
      "patchSize": 4,
      "normalize": true,
      "augmentation": {
        "randomCropPadding": 4,
        "horizontalFlip": true,
        "verticalFlip": false
      }
    },
    "evaluationData": {
      "type": "cifar100",
      "dataPath": "data/cifar-100-binary/test.bin",
      "patchSize": 4,
      "normalize": true,
      "augmentation": {
        "randomCropPadding": 0,
        "horizontalFlip": false,
        "verticalFlip": false
      }
    }
  },
  "model": {
    "heads": 16,
    "hiddenSize": 512,
    "layers": 16,
    "seed": 43,
    "initializationScale": 0.02,
    "dropout": 0.1
  },
  "training": {
    "epochs": 200,
    "microBatchSize": 256,
    "microBatchCount": 1,
    "labelSmoothing": 0.1,
    "earlyStoppingPatience": 15,
    "earlyStoppingMinimumDelta": 0.0001
  },
  "runtime": {
    "seed": 1234,
    "useSimd": true
  },
  "optimization": {
    "optimizer": {
      "type": "gainshareadamw",
      "learningRate": 0.0003,
      "weightDecay": 0.0005,
      "gainShareBlockDepth": 1,
      "gainShareBeta1": 0.9,
      "gainShareBeta2": 0.999,
      "gainShareEpsilon": 1E-08,
      "gainShareRho": 0.95,
      "gainShareGamma": 1.0,
      "gainShareMinScale": 0.5,
      "gainShareMaxScale": 2.0
    },
    "scheduler": {
      "type": "linearWarmupCosineAnnealing",
      "warmupEpochs": 5,
      "minimumLearningRateRatio": 0.01
    }
  },
  "checkpoint": {
    "directory": "checkpoints/cifar100",
    "resume": false,
    "autoResume": true
  },
  "reporting": {
    "showLossGraph": true
  }
}
