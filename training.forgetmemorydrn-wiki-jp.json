{
  "task": "gpt_rin_wiki_jp",
  "dataPath": "data/wiki",
  "textColumn": "text",
  "tokenizerPath": "wiki-jp-bpe.json",
  "checkpoint": {
    "directory": "checkpoints",
    "fileName": "training.forgetmemorydrn-wiki-jp.model.json",
    "resume": false,
    "autoResume": true
  },

  "vocabularySize": 4096,
  "tokenizerTrainingDocuments": 5000,
  "tokenizerTrainingBytes": 2000000,

  "maxTrainingDocuments": 0,
  "maxTrainingTokens": 0,
  "maxDocumentTokens": 1024,
  "validationFraction": 0.0,
  "epochs": 1,
  "batchSize": 16,

  "contextLength": 1024,
  "modelWidth": 512,
  "heads": 8,
  "hiddenSize": 1024,
  "layers": 16,
  "modelArchitecture": "forgetmemorydrn",
  "device": "cuda",
  "deviceIndex": 0,
  "deviceIndices": [0, 1],
  "precisionMode": "bfloat16",
  "forgetMemoryKeyWidth": 16,
  "forgetMemoryValueWidth": 16,
  "forgetMemoryRetentionMinimum": 0.5,
  "forgetMemoryRetentionMaximum": 0.99,
  "dropout": 0.1,
  "initializationScale": 0.02,

  "optimization": {
    "optimizer": {
      "type": "adamw",
      "learningRate": 0.0003,
      "auxiliaryLearningRate": 0.0003,
      "nekoMuonNewtonSchulzInterval": 5,
      "weightDecay": 0.01
    },
    "scheduler": {
      "type": "warmupCosineProgress",
      "warmupPercent": 20
    }
  },
  "seed": 1234,
  "logEveryBatches": 10,
  "showLossGraph": true,
  "graphUpdateSteps": 100,
  "datasetSampleEverySteps": 100,
  "datasetSamplePoolSize": 32,
  "useSimd": true,
  "maxDegreeOfParallelism": 0,

  "maxNewTokens": 80,
  "temperature": 0.8,
  "topK": 40
}
