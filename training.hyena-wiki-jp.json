{
  "task": "gpt_rin_wiki_jp",
  "dataPath": "data/wiki",
  "textColumn": "text",
  "tokenizerPath": "wiki-jp-bpe.json",
  "checkpoint": {
    "directory": "checkpoints",
    "fileName": "training.hyena-wiki-jp.model.json",
    "resume": false,
    "autoResume": true
  },

  "vocabularySize": 4096,
  "tokenizerTrainingDocuments": 5000,
  "tokenizerTrainingBytes": 2000000,

  "maxTrainingDocuments": 0,
  "maxTrainingTokens": 0,
  "maxDocumentTokens": 4096,
  "validationFraction": 0.0,
  "epochs": 1,
  "batchSize": 16,

  "contextLength": 64,
  "modelWidth": 512,
  "heads": 16,
  "hiddenSize": 512,
  "layers": 16,
  "modelArchitecture": "hyena",
  "hyenaFilterWidth": 64,
  "hyenaConvolutionAlgorithm": "auto",
  "dropout": 0.1,
  "initializationScale": 0.02,

  "optimization": {
    "optimizer": {
      "type": "nekomuon",
      "learningRate": 0.0003,
      "auxiliaryLearningRate": 0.0003,
      "nekoMuonNewtonSchulzInterval": 5,
      "weightDecay": 0.01,
      "adamWUseBFloat16FirstMoment": false,
      "adamWUseBFloat16SecondMoment": false
    },
    "scheduler": {
      "type": "warmupCosineProgress",
      "warmupPercent": 20
    }
  },
  "seed": 1234,
  "logEveryBatches": 10,
  "showLossGraph": true,
  "graphUpdateSteps": 100,
  "datasetSampleEverySteps": 100,
  "datasetSamplePoolSize": 32,
  "useSimd": true,
  "maxDegreeOfParallelism": 0,

  "maxNewTokens": 80,
  "temperature": 0.8,
  "topK": 40
}
