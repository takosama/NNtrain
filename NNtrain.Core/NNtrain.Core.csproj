<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NNtrain.Runtime\NNtrain.Runtime.csproj" />
    <ProjectReference Include="..\NNtrain.Cuda\NNtrain.Cuda.csproj" />
  </ItemGroup>

  <!-- The native F16C accelerator is optional.  A portable managed AVX2/
       scalar codec remains the default when this Windows x64 payload is not
       present or the processor does not advertise F16C. -->
  <ItemGroup Condition="Exists('runtimes\\win-x64\\native\\NNtrain.F16C.dll')">
    <None Include="runtimes\\win-x64\\native\\NNtrain.F16C.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="NNtrain.F16C.dll" />
  </ItemGroup>

  <ItemGroup Condition="Exists('runtimes\win-x64\native\NNtrain.CudaKernels.dll')">
    <None Include="runtimes\win-x64\native\NNtrain.CudaKernels.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="NNtrain.CudaKernels.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NtvLibs.cuda12.cublas64_12.runtime.win-x64" Version="12.8.1" />
    <PackageReference Include="NtvLibs.cuda12.cublasLt64_12.runtime.win-x64" Version="12.8.1" />
  </ItemGroup>

</Project>
