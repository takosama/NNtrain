<Window x:Class="NNtrain.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NNtrain チャット" Width="1080" Height="800" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen" Closing="MainWindow_Closing"
        Background="#0B1220" Foreground="#EEF3FA" FontFamily="Yu Gothic UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#263852"/>
            <Setter Property="Foreground" Value="#EEF3FA"/>
            <Setter Property="BorderBrush" Value="#45607D"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#DCE6F1"/>
            <Setter Property="Foreground" Value="#101925"/>
            <Setter Property="BorderBrush" Value="#45607D"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#172437"/>
            <Setter Property="Foreground" Value="#EEF3FA"/>
            <Setter Property="BorderBrush" Value="#45607D"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#263852"/>
            <Setter Property="Foreground" Value="#EEF3FA"/>
            <Setter Property="Padding" Value="18,9"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#186B6A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <TabControl Background="#0B1220" BorderBrush="#45607D" Foreground="#EEF3FA">
        <TabItem Header="チャット">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="NNtrain チャット" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Qwen3.5 / Qwen3.8 の GGUF と LoRA (.bin / .gguf) を選び、Arc GPU で会話します。"
                       Foreground="#9BAEC6" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#142136" CornerRadius="12" Padding="12,6" Margin="0,0,0,12">
            <Expander x:Name="SettingsExpander" IsExpanded="False" Foreground="#EEF3FA"
                      ToolTip="クリックしてモデルと生成設定を開閉します。設定値は保持されます。">
                <Expander.Header>
                    <TextBlock Text="モデル・生成設定" FontWeight="SemiBold" Margin="4,4,0,4"/>
                </Expander.Header>
            <Grid Margin="4,8,4,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="モデル" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ModelComboBox"
                          SelectionChanged="ModelOrAdapter_SelectionChanged" ToolTip="使用する GGUF モデル">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding FilePath}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="0" Grid.Column="2" Content="参照…" Margin="10,0,0,0"
                        Click="BrowseModel_Click"/>
                <Button Grid.Row="0" Grid.Column="3" Content="再読込" Margin="8,0,0,0"
                        Click="RefreshModels_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="LoRA" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AdapterComboBox" Margin="0,10,0,0"
                          SelectionChanged="ModelOrAdapter_SelectionChanged" ToolTip="LoRA アダプター。なしも選べます。">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding FilePath}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="2" Content="参照…" Margin="10,10,0,0"
                        Click="BrowseAdapter_Click"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="使用GPU" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="GpuComboBox"
                          Margin="0,10,0,0" DisplayMemberPath="Label"
                          SelectionChanged="ModelOrAdapter_SelectionChanged"
                          ToolTip="推論に使用する Arc GPU の組み合わせ"/>

                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                            Margin="0,14,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="ThinkingCheckBox" Content="Thinking: On" IsChecked="True"
                              Foreground="#D8F7F1" FontWeight="SemiBold" VerticalAlignment="Center"
                              ToolTip="オン: 思考を生成中に折りたたみ表示できます。オフ: モデルに思考を要求しません。"
                              Checked="Thinking_Changed" Unchecked="Thinking_Changed" Margin="0,0,18,0"/>
                    <CheckBox x:Name="StreamCheckBox" Content="Stream: On" IsChecked="True"
                              Foreground="#D8F7F1" FontWeight="SemiBold" VerticalAlignment="Center"
                              ToolTip="オン: 回答を逐次表示します。オフ: 完了後にまとめて表示します。"
                              Checked="Stream_Changed" Unchecked="Stream_Changed" Margin="0,0,18,0"/>
                    <TextBlock Text="最大生成数" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="MaxTokensBox" Text="512" Width="78" Height="36" VerticalContentAlignment="Center"
                             ToolTip="1 ～ 8192 トークン"/>
                    <Button x:Name="PreloadButton" Content="プリロード" Click="Preload_Click"
                            Background="#186B6A" BorderBrush="#2C9E96" Margin="20,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="サンプリング" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                            Margin="0,10,0,0" VerticalAlignment="Center">
                    <TextBlock Text="temperature" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TemperatureBox" Text="0.6" Width="64" Height="36" VerticalContentAlignment="Center"
                             ToolTip="0 は greedy、通常は 0.6" Margin="0,0,20,0"/>
                    <TextBlock Text="top-p" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TopPBox" Text="0.95" Width="64" Height="36" VerticalContentAlignment="Center"
                             ToolTip="0 より大きく 1 以下" Margin="0,0,20,0"/>
                    <TextBlock Text="top-k" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TopKBox" Text="20" Width="64" Height="36" VerticalContentAlignment="Center"
                             ToolTip="候補に残すトークン数（1 ～ 256）"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="画像 mmproj" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="MmprojComboBox" Margin="0,10,0,0"
                          SelectionChanged="ModelOrAdapter_SelectionChanged"
                          ToolTip="モデルに対応する Qwen3.5 の mmproj GGUF。NNtrain 本体で画像を処理します。">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding FilePath}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="5" Grid.Column="2" Content="参照…" Margin="10,10,0,0" Click="BrowseMmproj_Click"/>

            </Grid>
            </Expander>
        </Border>

        <Border Grid.Row="2" Background="#142136" CornerRadius="10" Padding="12,9" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="モデルを選んでください。" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="MemoryStatusText" Text="GPU: 未読込"
                           Foreground="#83DCCB" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#111D30" CornerRadius="12" Padding="12" Margin="0,0,0,12">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChatItems"
                              Width="{Binding ElementName=ChatScrollViewer, Path=ViewportWidth}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Background="#21324B" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                                        MaxWidth="820" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Author}" Foreground="#83DCCB"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="{Binding CopyContentLabel}"
                                                    Click="CopyContent_Click" IsEnabled="{Binding CanCopyContent}"
                                                    ToolTip="{Binding CopyContentLabel}" FontSize="11"
                                                    MinHeight="26" Padding="8,3" Margin="12,0,0,0"/>
                                        </Grid>
                                        <Grid Visibility="{Binding ThinkingVisibility}" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Expander Grid.Column="0"
                                                      IsExpanded="{Binding ThinkingExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Background="#172437" Foreground="#9BAEC6"
                                                      ToolTip="クリックして思考の内容を開閉">
                                                <Expander.Header>
                                                    <Border Background="#28415E" CornerRadius="5" Padding="10,6"
                                                            Cursor="Hand">
                                                        <TextBlock Text="{Binding ThinkingHeader}" Foreground="#B6F1E6"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </Expander.Header>
                                                <TextBlock Text="{Binding ThinkingContent}" TextWrapping="Wrap"
                                                           Foreground="#C6D3E5" Margin="8,4,8,8"/>
                                            </Expander>
                                            <Button Grid.Column="1" Content="思考をコピー" Click="CopyThinking_Click"
                                                    IsEnabled="{Binding CanCopyThinking}" ToolTip="思考の内容だけをコピー"
                                                    VerticalAlignment="Top" FontSize="11" MinHeight="26"
                                                    Padding="8,3" Margin="8,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayContent}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="AttachImageButton" Content="画像を添付" Click="AttachImage_Click" Padding="10,4" MinHeight="30"/>
                    <Button x:Name="RemoveImageButton" Content="画像を外す" Click="RemoveImage_Click" Padding="10,4" MinHeight="30"/>
                    <Button x:Name="NewConversationButton" Content="新しい会話" Click="NewConversation_Click" Padding="10,4" MinHeight="30"/>
                    <TextBlock x:Name="ImageAttachmentText" Text="画像なし" Foreground="#9BAEC6" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="AsrRecordButton" Content="録音開始" Click="AsrRecord_Click" Padding="10,4" MinHeight="30"/>
                    <Button x:Name="AsrStopButton" Content="録音停止" Click="AsrStop_Click" Padding="10,4" MinHeight="30"/>
                    <Button x:Name="AsrCancelButton" Content="音声取消" Click="AsrCancel_Click" Padding="10,4" MinHeight="30"/>
                    <Button x:Name="AsrFileButton" Content="音声ファイル" Click="AsrFile_Click" Padding="10,4" MinHeight="30" ToolTip="16bit PCM WAVをチャット入力欄へ認識します。"/>
                </WrapPanel>
                <Expander x:Name="AsrSettingsExpander" Header="音声モデル：Nemotron 3.5 ASR" Foreground="#D8F7F1" Margin="0,0,0,5">
                    <Grid Margin="0,6,0,6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="AsrModelComboBox" DisplayMemberPath="Label" SelectionChanged="AsrModel_SelectionChanged" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="AsrDirectoryBox" ToolTip="音声モデルのフォルダー（config.json / tokenizer.json / model.safetensors）"/>
                        <Button Grid.Row="1" Grid.Column="2" x:Name="AsrBrowseButton" Content="モデル選択" Click="AsrBrowse_Click" Margin="8,0,0,0"/>
                        <ComboBox Grid.Column="1" x:Name="AsrGpuComboBox" DisplayMemberPath="Label" SelectionChanged="AsrGpu_SelectionChanged" Margin="0,6,0,0"/>
                        <Button Grid.Column="2" x:Name="AsrLoadButton" Content="FP16読込" Click="AsrLoad_Click" Margin="8,6,0,0"/>
                    </Grid>
                </Expander>
                <TextBlock x:Name="AsrStatusText" Text="音声モデル未読込。録音は開始ボタンを押したときだけ行います。"
                           Foreground="#9BAEC6" FontSize="12" TextWrapping="Wrap" Margin="3,0,0,5"/>
                <TextBox x:Name="MessageBox" MinHeight="82" MaxHeight="180" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="MessageBox_PreviewKeyDown"/>
                <TextBlock Text="Ctrl+Enter で送信。生成中は停止できます。"
                           Foreground="#9BAEC6" FontSize="12" Margin="3,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Button x:Name="SendButton" Content="送信" Click="Send_Click" Width="92"
                        Margin="0,0,0,8" Background="#186B6A" BorderBrush="#2C9E96"/>
                <Button x:Name="StopButton" Content="停止" Click="Stop_Click" Width="92"
                        Margin="0" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
        </TabItem>

        <TabItem Header="Hugging Face">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Hugging Face からモデルを取得" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="GGUF と mmproj を選択して models フォルダーへ保存します。"
                               Foreground="#9BAEC6" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#142136" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="モデルリポジトリ（owner/name またはURL）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="HfInspectButton" Content="一覧を取得" DockPanel.Dock="Right"
                                    Margin="10,0,0,0" Click="HfInspect_Click"/>
                            <TextBox x:Name="HfRepositoryBox" VerticalContentAlignment="Center"
                                     ToolTip="例: owner/repository または https://huggingface.co/owner/repository"/>
                        </DockPanel>
                        <TextBlock Text="別リポジトリの mmproj（任意）" Margin="0,12,0,8" FontWeight="SemiBold"/>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="HfInspectMmprojButton" Content="mmproj一覧を取得" DockPanel.Dock="Right"
                                    Margin="10,0,0,0" Click="HfInspectMmproj_Click"/>
                            <TextBox x:Name="HfMmprojRepositoryBox" VerticalContentAlignment="Center"
                                     ToolTip="mmproj が別の Hugging Face リポジトリにある場合のみ入力"/>
                        </DockPanel>
                        <TextBlock x:Name="HfMmprojRepositoryStatusText" Foreground="#9BAEC6"
                                   Text="同じリポジトリにある mmproj は上の一覧にも表示されます。"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="Hugging Face トークン（公開モデルでは空欄）" Margin="0,12,0,6"/>
                        <PasswordBox x:Name="HfTokenBox" Background="#172437" Foreground="#EEF3FA"
                                     BorderBrush="#45607D" Padding="10,8" MaxLength="512"/>
                        <TextBlock Text="制限付きモデルは、Hugging Face側で利用許諾後にトークンを入力してください。トークンは保存しません。"
                                   Foreground="#9BAEC6" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#142136" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="HfRepositoryStatusText" Text="リポジトリを入力して一覧を取得してください。"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="HfDestinationText" Foreground="#9BAEC6" TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Background="#111D30" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="取得するファイルをチェックしてください。GGUFと別リポジトリのmmprojを一緒に選択できます。"
                                   FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <ListBox x:Name="HfFilesList" Background="#111D30" Foreground="#EEF3FA"
                                 BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,3,4,8"
                                              Foreground="#EEF3FA" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#9BAEC6" FontSize="12"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="4" Background="#142136" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="HfDownloadStatusText" Text="ダウンロード待機中" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="HfDownloadProgressBar" Height="16" Minimum="0" Maximum="100"
                                     Margin="0,9,0,5"/>
                        <TextBlock x:Name="HfDownloadBytesText" Foreground="#9BAEC6" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="HfDownloadButton" Content="選択したファイルをダウンロード"
                                    Background="#186B6A" BorderBrush="#2C9E96" Click="HfDownload_Click"/>
                            <Button x:Name="HfCancelButton" Content="キャンセル" Click="HfCancel_Click"
                                    IsEnabled="False"/>
                            <Button Content="models フォルダーを開く" Click="HfOpenModels_Click"/>
                        </StackPanel>
                    <TextBlock Text="対応する Qwen3.5 の mmproj をチャットで選ぶと、NNtrain 本体で画像を処理できます。"
                                   Foreground="#9BAEC6" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
