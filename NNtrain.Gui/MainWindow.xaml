<Window x:Class="NNtrain.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NNtrain チャット" Width="1080" Height="800" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen" Closing="MainWindow_Closing"
        Background="#0B1220" Foreground="#EEF3FA" FontFamily="Yu Gothic UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#263852"/>
            <Setter Property="Foreground" Value="#EEF3FA"/>
            <Setter Property="BorderBrush" Value="#45607D"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#DCE6F1"/>
            <Setter Property="Foreground" Value="#101925"/>
            <Setter Property="BorderBrush" Value="#45607D"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#172437"/>
            <Setter Property="Foreground" Value="#EEF3FA"/>
            <Setter Property="BorderBrush" Value="#45607D"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="NNtrain チャット" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Qwen3.5 / Qwen3.8 の GGUF と LoRA (.bin) を選び、Arc GPU で会話します。"
                       Foreground="#9BAEC6" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#142136" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="モデル" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ModelComboBox"
                          SelectionChanged="ModelOrAdapter_SelectionChanged" ToolTip="使用する GGUF モデル">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding FilePath}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="0" Grid.Column="2" Content="参照…" Margin="10,0,0,0"
                        Click="BrowseModel_Click"/>
                <Button Grid.Row="0" Grid.Column="3" Content="再読込" Margin="8,0,0,0"
                        Click="RefreshModels_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="LoRA (.bin)" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AdapterComboBox" Margin="0,10,0,0"
                          SelectionChanged="ModelOrAdapter_SelectionChanged" ToolTip="LoRA アダプター。なしも選べます。">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding FilePath}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="2" Content="参照…" Margin="10,10,0,0"
                        Click="BrowseAdapter_Click"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="使用GPU" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="GpuComboBox"
                          Margin="0,10,0,0" DisplayMemberPath="Label"
                          SelectionChanged="ModelOrAdapter_SelectionChanged"
                          ToolTip="推論に使用する Arc GPU の組み合わせ"/>

                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                            Margin="0,14,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="ThinkingCheckBox" Content="Thinking: On" IsChecked="True"
                              Foreground="#D8F7F1" FontWeight="SemiBold" VerticalAlignment="Center"
                              ToolTip="オン: 思考を生成中に折りたたみ表示できます。オフ: モデルに思考を要求しません。"
                              Checked="Thinking_Changed" Unchecked="Thinking_Changed" Margin="0,0,24,0"/>
                    <TextBlock Text="最大生成数" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="MaxTokensBox" Text="512" Width="78" Height="36" VerticalContentAlignment="Center"
                             ToolTip="1 ～ 8192 トークン"/>
                    <Button x:Name="PreloadButton" Content="プリロード" Click="Preload_Click"
                            Background="#186B6A" BorderBrush="#2C9E96" Margin="20,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="サンプリング" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                            Margin="0,10,0,0" VerticalAlignment="Center">
                    <TextBlock Text="temperature" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TemperatureBox" Text="0.6" Width="64" Height="36" VerticalContentAlignment="Center"
                             ToolTip="0 は greedy、通常は 0.6" Margin="0,0,20,0"/>
                    <TextBlock Text="top-p" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TopPBox" Text="0.95" Width="64" Height="36" VerticalContentAlignment="Center"
                             ToolTip="0 より大きく 1 以下" Margin="0,0,20,0"/>
                    <TextBlock Text="top-k" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TopKBox" Text="20" Width="64" Height="36" VerticalContentAlignment="Center"
                             ToolTip="候補に残すトークン数（1 ～ 256）"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#142136" CornerRadius="10" Padding="12,9" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="モデルを選んでください。" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="MemoryStatusText" Text="GPU: 未読込"
                           Foreground="#83DCCB" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#111D30" CornerRadius="12" Padding="12" Margin="0,0,0,12">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChatItems"
                              Width="{Binding ElementName=ChatScrollViewer, Path=ViewportWidth}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Background="#21324B" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                                        MaxWidth="820" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Author}" Foreground="#83DCCB"
                                                   FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <Expander Visibility="{Binding ThinkingVisibility}"
                                                  IsExpanded="{Binding ThinkingExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Background="#172437" Foreground="#9BAEC6"
                                                  ToolTip="クリックして思考の内容を開閉" Margin="0,0,0,8">
                                            <Expander.Header>
                                                <Border Background="#28415E" CornerRadius="5" Padding="10,6"
                                                        Cursor="Hand">
                                                    <TextBlock Text="{Binding ThinkingHeader}" Foreground="#B6F1E6"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </Expander.Header>
                                            <TextBlock Text="{Binding ThinkingContent}" TextWrapping="Wrap"
                                                       Foreground="#C6D3E5" Margin="8,4,8,8"/>
                                        </Expander>
                                        <TextBlock Text="{Binding DisplayContent}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBox x:Name="MessageBox" MinHeight="82" MaxHeight="180" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="MessageBox_PreviewKeyDown"/>
                <TextBlock Text="Ctrl+Enter で送信。生成中は停止できます。"
                           Foreground="#9BAEC6" FontSize="12" Margin="3,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Button x:Name="SendButton" Content="送信" Click="Send_Click" Width="92"
                        Margin="0,0,0,8" Background="#186B6A" BorderBrush="#2C9E96"/>
                <Button x:Name="StopButton" Content="停止" Click="Stop_Click" Width="92"
                        Margin="0" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
