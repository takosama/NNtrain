{
  "schemaVersion": 1,
  "objective": "sft",
  "loraConfig": "lora.json",
  "tokenizerPath": "fineweb-bpe.json",
  "dataPath": "data/lora/train.jsonl",
  "adapterPath": "checkpoints/lora/drn.adapter.json",
  "device": "cuda",
  "deviceIndex": 0,
  "contextLength": 512,
  "batchSize": 2,
  "gradientAccumulationSteps": 8,
  "epochs": 1,
  "maxSteps": 100,
  "learningRate": 0.00005,
  "weightDecay": 0,
  "gradientClip": 1,
  "saveEverySteps": 50,
  "resume": false,
  "promptPrefix": "### 指示:\n",
  "responsePrefix": "\n\n### 回答:\n",
  "maxNewTokens": 128,
  "temperature": 0.7,
  "topK": 40
}
