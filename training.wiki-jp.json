{
  "task": "gpt_rin_wiki_jp",
  "dataPath": "data/wiki",
  "textColumn": "text",
  "tokenizerPath": "wiki-jp-bpe.json",
  "checkpointPath": "training.forgetmemoryv2-wiki-jp.model.json",
  "resumeFromCheckpoint": false,
  "autoResume": true,

  "vocabularySize": 4096,
  "tokenizerTrainingDocuments": 5000,
  "tokenizerTrainingBytes": 2000000,

  "maxTrainingDocuments": 0,
  "maxTrainingTokens": 0,
  "maxDocumentTokens": 512,
  "validationFraction": 0.0,
  "epochs": 1,
  "batchSize":16,

  "contextLength": 512,
  "modelWidth": 384,
  "heads": 8,
  "hiddenSize": 1152,
  "layers":8,
  "modelArchitecture": "forgetmemoryv2",
  "forgetMemoryKeyWidth": 16,
  "forgetMemoryValueWidth": 16,
  "forgetMemoryRetentionMinimum": 0.5,
  "forgetMemoryRetentionMaximum": 0.99,
  "dropout": 0.1,
  "initializationScale": 0.02,

  "optimizer": "adamw",
  "learningRate": 0.0003,
  "auxiliaryLearningRate": 0.0003,
  "nekoMuonNewtonSchulzInterval": 5,
  "warmupPercent": 20,
  "weightDecay": 0.01,
  "adamWUseBFloat16FirstMoment": true,
  "adamWUseBFloat16SecondMoment": true,
  "seed": 1234,
  "logEveryBatches": 10,
  "showLossGraph": true,
  "graphUpdateSteps": 100,
  "datasetSampleEverySteps": 100,
  "datasetSamplePoolSize": 32,
  "useSimd": true,
  "maxDegreeOfParallelism": 0,

  "maxNewTokens": 80,
  "temperature": 0.8,
  "topK": 40
}
