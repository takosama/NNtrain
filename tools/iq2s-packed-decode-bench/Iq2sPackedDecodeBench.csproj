<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NNtrain.Iq2sPackedDecodeBench</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NNtrainArchitectureLayer>Benchmarks</NNtrainArchitectureLayer>
    <NNtrainAllowedProjectReferences>NNtrain.Core;NNtrain.Arc</NNtrainAllowedProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../NNtrain.Core/NNtrain.Core.csproj" />
    <ProjectReference Include="../../NNtrain.Arc/NNtrain.Arc.csproj" />
    <Compile Include="../iq2s-production-bench/ReferenceData.cs" Link="ReferenceData.cs" />
    <None Include="../../NNtrain.Arc/Kernels/qwen35_iq.cl" Link="qwen35_iq.cl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
