    <NNtrainArchitectureLayer>Cli</NNtrainArchitectureLayer>
    <NNtrainAllowedProjectReferences>NNtrain.Core;NNtrain.Data;NNtrain.Training;NNtrain.Gemma</NNtrainAllowedProjectReferences>
  </PropertyGroup>

  <ItemGroup>
